# ══════════════════════════════════════════════════════
# GÜRGENTEKSTIL - Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve doldurun
# Production'da .env.production olarak da ayarlayın
# ══════════════════════════════════════════════════════

# ── Supabase (Zorunlu) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Admin JWT Secret ──────────────────────────────────
# Güvenli, uzun, rastgele bir string — değiştirin!
ADMIN_JWT_SECRET=buraya_cok_gizli_bir_string_yazin

# ── Site URL ──────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://gurgentekstil.com
NEXT_PUBLIC_SITE_URL=https://gurgentekstil.com

# ── Google Search Console ─────────────────────────────
# GSC'de "HTML Tag" doğrulama metodunu seçince alacağınız kod
# Örnek: abc123def456...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Domain Notları ───────────────────────────────────
# gürgentekstil.com = xn--grgentekstil-dlb.com (Punycode/IDN)
# Her ikisini de satın alın — gurgentekstil.com (ü'süz) önerilir
# next.config.ts'de her iki domain → gurgentekstil.com redirect mevcut
